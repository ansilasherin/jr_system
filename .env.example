SECRET_KEY=your-django-secret-key
DEBUG=True

# PostgreSQL
DB_ENGINE=postgresql
DB_NAME=jr_system
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432

# Alternatively, you can use one PostgreSQL URL instead of the DB_* fields.
# DATABASE_URL=postgresql://postgres:your_db_password@localhost:5432/jr_system

# Email (Gmail SMTP)
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password

# AI providers
GROQ_API_KEY=your_groq_api_key
OPENAI_API_KEY=your_openai_api_key
CV_SKILL_AI_PROVIDER=auto
CV_SKILL_OPENAI_MODEL=gpt-4o-mini
CV_SKILL_GROQ_MODEL=llama-3.3-70b-versatile
